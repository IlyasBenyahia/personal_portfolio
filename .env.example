# Copy to .env and fill in. Only NEXT_PUBLIC_* values reach the browser,
# and they are inlined at build time (set them in Cloudflare build settings too).

# Web3Forms public access key (contact form) — https://web3forms.com
NEXT_PUBLIC_WEB3FORMS_KEY=

# Umami Cloud website ID — https://cloud.umami.is
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# Cloudflare Web Analytics token (leave empty if enabled automatically by Cloudflare)
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=
