# Cloudflare static assets headers (also honoured by Cloudflare Pages).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://cloud.umami.is https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://api.web3forms.com https://cloud.umami.is https://api-gateway.umami.dev https://cloudflareinsights.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://api.web3forms.com

# Hashed build assets never change.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Build-time generated images have no file extension.
/:locale/opengraph-image
  Content-Type: image/png
/:locale/twitter-image
  Content-Type: image/png
/:locale/projects/:slug/opengraph-image
  Content-Type: image/png
/:locale/projects/:slug/twitter-image
  Content-Type: image/png
/apple-icon
  Content-Type: image/png
